<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>pokedex - etusivu</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>Pokedex</h1>
  </header>
  <main>
    <div class="sukupolvet">
      <% const roomalaiset = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX']; %>
      <% for (let i = 0; i < 9; i++) { %>
        <a href="/sukupolvi/<%= i+1 %>" class="nappi"><%= roomalaiset[i] %></a>
      <% } %>
    </div>
  </main>
</body>
</html>